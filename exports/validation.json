  "provenance": {
    "engine_roll_deg": "15-degree magnitude is an OEM K20/K24 slant quoted by ATI, not a verified KPower NA/NB installation angle. Roll about X is -15 degrees: reversed from the initial +15-degree model per the user's direction correction; negative Y is now the high side. Individual panel angles remain unmeasured. Editable; no longitudinal pitch inferred.",
    "engine_roll_source": "https://www.atiracing.com/links/pr/2025/09-Honda-K20_K24_Adapter_kit/ describes straight-up orientation and OEM 15 degree slant.",
    "kpower_angle_check": "K24Z3 Installation Guide, October 2020 revision 2, checked for angle: no numerical engine roll specification found. Page 21 supplies additional pan photographs.",
    "construction": "Sump floors, bridge floor and rear wing ledges are parallel to the floor datum. Side panels retain their flange-normal directions and are trimmed to the level floors, giving non-square floor joints. Hidden panel orientations remain estimates.",
    "depths": "Vertical distances from flange center to the outer floors, not distances normal to the tilted flange. The small well bottom is Z=0 in exported files.",
    "length_mm": "Provisional scale based on the listed 456 mm overall length of ACKOJA A26-0159, an OEM-pattern replacement cross-referenced to 11200-PNA-000/11200-RAA-A00. Not a verified K24Z3 flange measurement.",
    "flange_width_mm": "Provisional scale based on the listed 270 mm overall width of ACKOJA A26-0159. Overall pan width is not necessarily mounting-plate width; this correspondence is an assumption.",
    "stock_reference": "https://spareto.com/products/ackoja-oil-sump/a26-0159 lists Length 456, Width 270, Height 140 mm separately from shipping details.",
    "stock_reference_cross_check": "https://www.autodoc.co.uk/ackojap/14480037 independently lists the same part dimensions and separate packaging dimensions.",
    "wall_mm": "Manufacturer V2 specification: .100 inch. Photo version is not confirmed.",
    "rail_mm": "Manufacturer V2 specification: 3/8 inch. Photo version is not confirmed.",
    "all_other_dimensions": "Unmeasured photo-proportion estimates, constrained by a provisional stock-pattern overall envelope; not manufacturer dimensions.",
    "rear_outline_uv": "Photo-proportioned rear reservoir, refined per the user's symmetry correction: the negative-Y bung side is pulled inward 30 mm in flange coordinates and its shoulders now mirror the opposite shoulder about the throat centre. The slight positive-Y rear taper remains. Narrow throat and broad straight rear edge are preserved. u runs bridge-to-rear; v runs photo-left (+Y) to photo-right (-Y) across the 300 mm reference span. The active v=0..0.90 profile spans 270 mm in flange coordinates. Photo references: copilot-image-d8fdda.png / copilot-image-41c7ac.png. No perspective calibration or measured fit claimed.",
    "rear_sump_width_mm": "Reference span for normalized rear_outline_uv, not necessarily the occupied polygon width. Current profile uses 90 percent of this span.",
    "bolt_pattern": "16 hole centres extracted from user-supplied copilot-image-fe0fd3.png; outer and inner contours traced into flange_profile.json. X/Y scaled to provisional 456 x 270 mm. Relative layout is image-derived, not generic spacing; absolute dimensions, hole bores and handedness remain unverified.",
    "flange_border_mm": "Legacy body-layout parameter only. The flange border itself now follows separately traced inner and outer contours, not a constant-width inset.",
    "drains": "Illustrative position and bore; no threads or sealing-seat specification. Drain heights follow their local floors. Rear drain, bore and plug follow the actual negative-Y profile wall, including the inward symmetry correction; its physical position is still unverified. Overflow is on the high-rail side above the bridge floor.",
    "baffles": "Conceptual placement; hidden trap-door geometry is not established by the photos.",
    "capacity": "Manufacturer quotes 6 US quarts for the real system; this model is not calibrated to that capacity.",
    "orientation": "X runs between the small box well and broad polygonal well. Vehicle front/rear assignment is inferred."
  }
